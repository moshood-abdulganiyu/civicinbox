# OpenAI API key — required for LLM classification endpoints.
# Get one at https://platform.openai.com/api-keys
# NEVER commit your real key. Copy this file to `.env` and fill in the real value there.
   OPENAI_API_KEY=your-openai-api-key-here
   GROQ_API_KEY=your-groq-api-key-here

# Optional — defaults to gpt-4o-mini in app/services/llm_client.py if unset.
# Budget-aware default per the master plan: quality matters here, but this
# is the only paid call in the whole project, so keep it cheap by default.
OPENAI_MODEL=gpt-4o-mini